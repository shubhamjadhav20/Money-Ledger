{
  "name": "ledger",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm test:web && pnpm build",
    "fixtures": "node scripts/generate-fixtures.ts",
    "test:coverage": "vitest run --coverage",
    "test:web": "pnpm --filter @ledger/web test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.2",
    "pdfjs-dist": "6.5.438",
    "pdfkit": "0.20.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
