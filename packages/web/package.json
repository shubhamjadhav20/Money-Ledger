{
  "name": "@ledger/web",
  "version": "0.0.0",
  "private": true,
  "description": "Angular app: dashboard, import, transactions, reconcile, pots, quick-add. Talks to the API with scoped tokens only.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ledger/core": "workspace:*",
    "pdfjs-dist": "6.5.438",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0"
  },
  "engines": {
    "node": "^24.15.0"
  }
}
